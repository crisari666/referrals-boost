# Backend API base URL (no trailing slash)
VITE_BASE_URL=URL
VITE_BASE_URL_STATIC =URL

# RAG Agent API (projects)
VITE_URL_RAG_AGENT=URL
VITE_URL_RAG_AGENT_UPLOADS=URL

# CRM Socket.IO (same server as admin CRM; use http://host:port or ws://host:port)
VITE_URL_SOCKET=URL

# Optional: contract sign query param name (defaults to "contractSign")
# VITE_CONTRACT_SIGN_QUERY_PARAM=contractSign

# Google OAuth web client id only (Identity Services + Calendar Meet for virtual visits).
# Never put client_secret in the SPA. If a client_secret*.json was shared/committed, rotate it in Google Cloud Console.
# Enable Google Calendar API on the OAuth project.
# Authorized JavaScript origins: https://agent.laceiba.group and http://localhost:5173 (or your Vite port).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging (la-ceiba-34945 web app + Web Push key pair)
# VITE_FIREBASE_APIKEY=
# VITE_FIREBASE_AUTHDOMAIN=
# VITE_FIREBASE_PROJECTID=
# VITE_FIREBASE_STORAGEBUCKET=
# VITE_FIREBASE_MESSAGINGSENDERID=
# VITE_FIREBASE_APPID=
# VITE_FIREBASE_MEASUREMENTID=
# VITE_FIREBASE_VAPID_KEY=

# Mapbox public token (pk.*) for lot stock satellite map
# VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token
